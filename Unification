def unify(x, y, sub):
    if x == y:
        return sub

    if isinstance(x, str) and x.islower():
        if x in y:
            return None
        sub[x] = y
        return sub

    if isinstance(y, str) and y.islower():
        if y in x:
            return None
        sub[y] = x
        return sub

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x) != len(y):
            return None

        for a, b in zip(x[1:], y[1:]):
            for key in sub:
                a = str(a).replace(key, sub[key])
                b = str(b).replace(key, sub[key])

            sub = unify(a, b, sub)

            if sub is None:
                return None

        return sub

    return None


e1 = ("Eats", "x", "Apple")
e2 = ("Eats", "Riya", "y")

result = unify(e1, e2, {})

if result is None:
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution:", result)


